# Copy to .env and fill values. .env kabhi commit mat karna.
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/toolora
# Next.js frontend ka URL (CORS ke liye). Comma se multiple de sakte ho.
CORS_ORIGINS=http://localhost:3000,http://localhost:3100

# Admin login tokens sign karne ke liye. Kam se kam 32 random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# n8n automation ki secret key (x-api-key header). Ye key sirf drafts bana sakti hai.
AUTOMATION_API_KEY=

# Admin login (sirf `npm run create-admin` ke liye). Password kam se kam 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
