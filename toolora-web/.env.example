# Copy this file to .env.local and fill the values. .env.local kabhi commit mat karna.

# Public site URL (canonical/sitemap ke liye)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# "true" sirf production launch par. Baaki time site noindex rahegi.
NEXT_PUBLIC_SITE_INDEXABLE=false

# toolora-api (Express + MongoDB) ka URL. Server-only, browser me nahi jaata.
API_URL=http://localhost:4000
